# Copia este archivo como .env (local) o crea estas variables en Render → Environment.
# Nunca subas el .env real a GitHub.

# Mercado Pago (Tus integraciones → Credenciales). Usa las de PRUEBA mientras pruebas.
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (Tus integraciones → Webhooks). URL: https://<backend>/webhooks/mercadopago, evento "Order"
MP_WEBHOOK_SECRET=

# Supabase (Project Settings → API). service_role: solo en el servidor, nunca en el frontend.
SUPABASE_URL=https://cywgxsocudepyejqnuuc.supabase.co
SUPABASE_KEY=

# Monto del adelanto de la reserva en soles (mínimo que acepta Mercado Pago con Yape: 2)
RESERVA_MONTO=2

# Cómo paga el cliente el adelanto:
#   manual       → Yape directo: yapea a YAPE_NUMERO, sube la captura y el admin lo aprueba en el panel (por defecto)
#   mercadopago  → código de aprobación de Yape vía Mercado Pago (necesita MP_ACCESS_TOKEN)
PAGO_YAPE_MODO=manual
YAPE_NUMERO=951038509
YAPE_TITULAR=Barber Studio JP
# Imagen pública del QR de tu Yape (opcional; si no hay, se muestra solo el número)
YAPE_QR_URL=
# Firma los enlaces con los que el cliente sigue su reserva en vivo (cualquier texto largo y aleatorio)
SEGUIMIENTO_SECRET=

# Protección contra reservas falsas: máx. 6 intentos por hora por IP y 2 reservas pendientes por correo.
# "off" la desactiva SOLO para pruebas locales. En Render NO pongas esta variable (o déjala en "on").
LIMITES_RESERVA=on

# Correos con acceso al panel admin (separados por coma)
ADMIN_EMAILS=juniortovaradmin@gmail.com,juniortovar601@gmail.com

# Dominios que pueden llamar al backend (separados por coma)
CORS_ORIGINS=https://barberiajuniortovar.onrender.com,http://localhost:3000

# SMS (opcional)
ADMIN_PHONE=+51951038509
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
